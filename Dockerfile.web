# Dockerfile.web
FROM node:20-alpine AS builder

WORKDIR /app

# 의존성 파일 복사 및 설치
COPY src/web/package.json src/web/package-lock.json ./
RUN npm ci

# 소스 복사 및 빌드
COPY src/web/ ./
ENV DOCKER_BUILD=1

# NEXT_PUBLIC_* 변수는 빌드 시점에 JS 번들에 박혀야 하므로 ARG → ENV로 전달
ARG NEXT_PUBLIC_PIPELINE_TRIGGER_URL
ARG NEXT_PUBLIC_PIPELINE_TRIGGER_TOKEN
ENV NEXT_PUBLIC_PIPELINE_TRIGGER_URL=$NEXT_PUBLIC_PIPELINE_TRIGGER_URL
ENV NEXT_PUBLIC_PIPELINE_TRIGGER_TOKEN=$NEXT_PUBLIC_PIPELINE_TRIGGER_TOKEN

RUN npm run build

# 실행 단계
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# 빌드 결과물 복사
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

EXPOSE 3000

CMD ["npm", "run", "start"]
