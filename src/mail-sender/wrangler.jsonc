{
  "name": "work-experience-1953-mail-sender",
  "main": "src/index.js",
  "compatibility_date": "2026-07-22",
  // Resend API 키는 코드/설정 파일에 넣지 말고 아래 명령으로 등록한다:
  //   wrangler secret put RESEND_API_KEY
  // MANAGER_EMAIL(수신자), FROM_EMAIL(발신자)은 비밀값이 아니라 vars로 둔다.
  // 실제 지점별 담당자 이메일이 정해지면 vars.MANAGER_EMAIL을 교체한다 (이슈 #131).
  "vars": {
    "MANAGER_EMAIL": "site-admin@example.com",
    "FROM_EMAIL": "1953형제돼지국밥 대시보드 <onboarding@resend.dev>"
  }
}
