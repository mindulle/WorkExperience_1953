OPENAI_API_KEY="sk-..."
GOOGLE_CREDENTIALS_PATH="./service_account.json"
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/..."

# Groq API (이슈 #156: ai_engine.py AI 호출 antigravity → Groq 전환)
# 무료로 발급 가능: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."
# 선택 항목 — 비워두면 코드 기본값(qwen/qwen3.6-27b) 사용. Groq 라인업이 바뀌면
# https://console.groq.com/docs/models 에서 다시 확인 후 여기서 덮어쓸 것.
# GROQ_MODEL="qwen/qwen3.6-27b"
# 선택 항목 — qwen3.6-27b는 기본이 thinking 모드라 매 호출마다 긴 추론 텍스트를
# 먼저 출력한다. 단순 분류 작업엔 불필요해 코드 기본값이 "none"(꺼짐)으로 되어 있음.
# 모델을 바꿔서 이 파라미터가 오류를 내면 빈 문자열로 설정해 아예 안 보내게 할 수 있음.
# GROQ_REASONING_EFFORT="none"
